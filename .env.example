# ==========================================
# VIVELITE ERP - ENVIRONMENT CONFIGURATION TEMPLATE
# Copia este archivo a .env y define tus credenciales reales.
# NUNCA subas archivos .env con credenciales reales al repositorio.
# ==========================================

# 1. Base de Datos PostgreSQL (Local o Supabase Free)
# Local: postgresql://vivelite_user:password@localhost:5433/vivelite_db?schema=public
# Supabase (Modo Directo / Migraciones): postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?sslmode=require
# Supabase (Modo Pooler / Runtime): postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require
DATABASE_URL="postgresql://vivelite_user:your_secure_postgres_password_here@127.0.0.1:5433/vivelite_db?schema=public"
DIRECT_URL="postgresql://vivelite_user:your_secure_postgres_password_here@127.0.0.1:5433/vivelite_db?schema=public"

# 2. Redis & Colas BullMQ (Local o Upstash Redis Free)
# Upstash (URL directa con TLS): rediss://default:your_upstash_token@your-endpoint.upstash.io:6379
REDIS_URL=
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TLS=false

# 3. Backend API (NestJS en Render Free)
PORT=4000
NODE_ENV=development
API_PREFIX=api/v1
# En producción, colocar la URL de Vercel (ej: https://sistema-erp.vercel.app)
CORS_ORIGIN=http://localhost:3000

# 4. Seguridad de Sesiones & Tokens JWT
# Generar claves criptográficas seguras: openssl rand -base64 32
JWT_ACCESS_SECRET=your_jwt_access_secret_min_32_characters_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_min_32_characters_here
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# 5. Frontend (Next.js en Vercel)
# En Vercel configurar la URL del backend en Render (ej: https://vivelite-erp-backend.onrender.com/api/v1)
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
