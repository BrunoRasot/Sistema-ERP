# ==========================================
# VIVELITE - ENVIRONMENT CONFIGURATION TEMPLATE
# Copia este archivo a .env y define tus credenciales reales.
# NUNCA subas archivos .env con credenciales reales al repositorio.
# ==========================================

# 1. Base de Datos PostgreSQL
POSTGRES_USER=vivelite_user
POSTGRES_PASSWORD=your_secure_postgres_password_here
POSTGRES_DB=vivelite_db
POSTGRES_PORT=5433
DATABASE_URL="postgresql://vivelite_user:your_secure_postgres_password_here@127.0.0.1:5433/vivelite_db?schema=public"

# 2. Redis & Colas de Procesamiento
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# 3. Backend API (NestJS)
PORT=4000
NODE_ENV=development
API_PREFIX=api/v1
CORS_ORIGIN=http://localhost:3000

# 4. Seguridad de Sesiones & Tokens JWT
# Generar claves seguras con: openssl rand -base64 32
JWT_ACCESS_SECRET=your_jwt_access_secret_min_32_characters_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_min_32_characters_here
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# 5. Frontend (Next.js)
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
