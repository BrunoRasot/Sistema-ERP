{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "..",
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@modules/*": ["src/modules/*"],
      "@common/*": ["src/common/*"],
      "@database/*": ["src/database/*"],
      "@config/*": ["src/config/*"],
      "@integrations/*": ["src/integrations/*"]
    }
  },
  "include": ["src/**/*", "../tests/**/*"]
}
