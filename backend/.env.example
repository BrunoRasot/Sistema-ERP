# ==========================================
# BACKEND API (NestJS) - ENVIRONMENT TEMPLATE
# Copia este archivo a backend/.env para desarrollo local
# ==========================================

# Base de datos PostgreSQL
DATABASE_URL="postgresql://vivelite_user:your_secure_postgres_password_here@127.0.0.1:5433/vivelite_db?schema=public"

# Servidor HTTP
PORT=4000
NODE_ENV=development
API_PREFIX=api/v1
CORS_ORIGIN=http://localhost:3000

# Seguridad JWT (Generar con: openssl rand -base64 32)
JWT_ACCESS_SECRET=your_jwt_access_secret_min_32_characters_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_min_32_characters_here
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# Redis (Opcional en desarrollo básico)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
